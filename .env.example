# Copy to .env before running scripts/start-all.sh or docker compose up.
# Every variable referenced by any service's CLAUDE.md config section is
# listed here, per infra/CLAUDE.md.

# ---- Card service (Spring Boot + PostgreSQL) ----
CARD_SERVICE_PORT=8080
CARD_DB_NAME=kardiq
CARD_DB_USER=kardiq
CARD_DB_PASSWORD=kardiq

# ---- Graph RAG service (FastAPI + Neo4j) ----
GRAPH_RAG_PORT=8020
NEO4J_USER=neo4j
# Neo4j requires 8+ characters and rejects a password equal to the username.
NEO4J_PASSWORD=kardiq12345
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Seeds the LangChain/OpenAI demo cards + USES relationship on startup.
SEED_ON_STARTUP=true

# ---- MCP server (FastAPI) ----
MCP_SERVER_PORT=8010

# ---- Agent (FastAPI + LangChain) ----
AGENT_PORT=8000
LLM_PROVIDER=openai
# Set the key matching LLM_PROVIDER above - the agent fails fast at startup
# if the selected provider's key is missing. Leave the other provider's key
# blank; it's unused.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
LLM_REQUEST_TIMEOUT_SECONDS=20
LLM_MAX_OUTPUT_TOKENS=800
LLM_MAX_RETRIES=2

# ---- Frontend (Next.js) ----
FRONTEND_PORT=3000
# Read by the BROWSER, not another container - must be the host-exposed
# agent URL (localhost), never the internal Docker service name "agent".
NEXT_PUBLIC_AGENT_URL=http://localhost:8000
